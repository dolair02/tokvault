{
  "name": "tokvault",
  "private": true,
  "version": "1.0.0",
  "description": "Save, organize, search, and watch your favorite TikTok links across Web, iOS, and Android.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:init": "npx @capacitor/cli init TokVault com.tokvault.app --web-dir dist",
    "cap:ios": "npm run build && npx cap add ios && npx cap open ios",
    "cap:android": "npm run build && npx cap add android && npx cap open android",
    "cap:sync": "npm run build && npx cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
